# =============================================================================
# .env.example — CareerNexus Frontend
# =============================================================================
# Copy this file to `.env` for local development.
# DO NOT commit `.env` — it is listed in .gitignore and .dockerignore.
#
# For Docker builds, pass these as --build-arg (see DOCKER_DEPLOY.md).
# For Render deployments, add them as Environment Variables in the dashboard.
# =============================================================================

# Base URL of the CareerNexus backend API (no trailing slash)
VITE_APP_BACKEND_HOST=

# Port the backend is listening on (omit for standard 80/443)
VITE_APP_BACKEND_PORT=

